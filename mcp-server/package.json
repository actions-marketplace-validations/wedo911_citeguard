{
  "name": "citeguard-mcp-server",
  "version": "0.1.2",
  "description": "MCP server that checks whether a cited paper has been retracted, corrected, or flagged with an expression of concern -- via Crossref, including Retraction Watch records. No API key.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "citeguard-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "model-context-protocol",
    "retraction",
    "retracted",
    "retraction-watch",
    "expression-of-concern",
    "citations",
    "citation-checker",
    "bibliography",
    "doi",
    "crossref",
    "research-integrity",
    "reproducibility",
    "open-science",
    "scholarly",
    "academic",
    "literature-review",
    "peer-review",
    "ai-agent"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test tests/analyze.test.mjs tests/parsers.test.mjs",
    "prepublishOnly": "npm run build && node --test tests/analyze.test.mjs tests/parsers.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wedo911/citeguard.git",
    "directory": "mcp-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
